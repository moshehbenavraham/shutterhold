# Supabase (gallery media + lightbox metadata)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Contact form
#
# If VITE_CONTACT_FORM_ENDPOINT is set, the /contact and /about forms POST
# the visitor's message as JSON to that URL. Any 2xx response counts as
# success. The endpoint receives a payload shaped like:
#   { name: string; email: string; message: string; source?: string }
#
# If left unset, the forms fall back to opening a prefilled mailto: draft
# so visitor messages are never silently dropped.
VITE_CONTACT_FORM_ENDPOINT=""

# Email address used by the mailto fallback (and shown in error copy when
# the endpoint above fails). Defaults to hello@morganblake.com when blank.
VITE_CONTACT_EMAIL=""
